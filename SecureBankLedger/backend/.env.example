################################################################################
# SecureBank Ledger — backend/.env.example
################################################################################

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://securebank:securebank_secret@localhost:5432/securebank

# JWT
JWT_SECRET=your_jwt_secret_change_in_production_must_be_32_chars_min
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production_must_be_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Fabric
FABRIC_CHANNEL=banking-channel
FABRIC_MSP_ID=BankOrgMSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_TLS_ROOT_CERT=../network/organizations/peerOrganizations/bank.com/peers/peer0.bank.com/tls/ca.crt
FABRIC_WALLET_PATH=../network/wallet

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
